{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OOXML Toolkit",
  "version": "../package.json",
  "identifier": "dev.ooxml-toolkit.app",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:5199",
    "beforeBuildCommand": "npm run build:tauri-renderer",
    "frontendDist": "../out/tauri"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OOXML Toolkit",
        "width": 1360,
        "height": 860,
        "minWidth": 860,
        "minHeight": 520,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 13 },
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "copyright": "Copyright © 2026 Dominik Paľo",
    "shortDescription": "View, edit and compare OOXML packages",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      { "ext": ["docx"], "name": "Word document", "role": "Editor" },
      { "ext": ["docm"], "name": "Word macro-enabled document", "role": "Editor" },
      { "ext": ["dotx"], "name": "Word template", "role": "Editor" },
      { "ext": ["xlsx"], "name": "Excel workbook", "role": "Editor" },
      { "ext": ["xlsm"], "name": "Excel macro-enabled workbook", "role": "Editor" },
      { "ext": ["xltx"], "name": "Excel template", "role": "Editor" },
      { "ext": ["pptx"], "name": "PowerPoint presentation", "role": "Editor" },
      { "ext": ["pptm"], "name": "PowerPoint macro-enabled presentation", "role": "Editor" },
      { "ext": ["potx"], "name": "PowerPoint template", "role": "Editor" },
      { "ext": ["ppsx"], "name": "PowerPoint slide show", "role": "Editor" },
      { "ext": ["vsdx"], "name": "Visio drawing", "role": "Viewer" },
      { "ext": ["odt"], "name": "OpenDocument text", "role": "Viewer" },
      { "ext": ["ods"], "name": "OpenDocument spreadsheet", "role": "Viewer" },
      { "ext": ["odp"], "name": "OpenDocument presentation", "role": "Viewer" }
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
