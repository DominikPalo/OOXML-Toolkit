{
  "name": "ooxml-toolkit",
  "productName": "OOXML Toolkit",
  "version": "0.4.1",
  "description": "Cross-platform desktop app to view, edit and compare OOXML files (DOCX, XLSX, PPTX and friends).",
  "author": "Dominik Paľo",
  "license": "MIT",
  "homepage": "https://github.com/DominikPalo/OOXML-Toolkit#readme",
  "bugs": {
    "url": "https://github.com/DominikPalo/OOXML-Toolkit/issues"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run build && node e2e/smoke.mjs",
    "e2e:inspector": "npm run build && node e2e/inspector-drafts.mjs",
    "e2e:external": "npm run build && node e2e/external-change.mjs",
    "samples": "esbuild scripts/make-samples.ts --bundle --platform=node --format=esm --outfile=out/scripts/make-samples.mjs --log-level=warning && node out/scripts/make-samples.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\" \"tests/**/*.ts\" \"scripts/**/*.{ts,cjs}\" \"e2e/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,html}\" \"tests/**/*.ts\" \"scripts/**/*.{ts,cjs}\" \"e2e/**/*.mjs\"",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "icon": "electron scripts/render-icon.cjs",
    "screenshots": "npm run build && node e2e/screenshots.mjs",
    "demo": "npm run build && node e2e/demo.mjs"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "codemirror": "^6.0.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "emf-converter": "4.24.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "lucide-react": "^1.61.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  }
}
